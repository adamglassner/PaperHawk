<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette (Hawkline, PaperHawk crimson). Every key here must also exist in Dark.xaml.
         PDF pages themselves are always drawn white, like paper; Brush.Canvas is the area around them. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F7F3F4" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F3ECEE" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E8DDE0" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#ECE2E5" />
    <SolidColorBrush x:Key="Brush.Track" Color="#EFE6E8" />
    <SolidColorBrush x:Key="Brush.Text" Color="#24161A" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6B5A5F" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#10000000" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#241216" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#CBB2B8" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#33191F" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#47222A" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#33191F" />
    <SolidColorBrush x:Key="Brush.Hero" Color="#241216" />
    <SolidColorBrush x:Key="Brush.HeroText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.HeroMuted" Color="#CBB2B8" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#C42F3D" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FBE3E6" />
    <SolidColorBrush x:Key="Brush.Highlight" Color="#FF8E99" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#F2A93B" />
    <SolidColorBrush x:Key="Brush.Marker" Color="#FFE58A" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#B86A12" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C2410C" />
    <SolidColorBrush x:Key="Brush.Positive" Color="#1F7A55" />
    <SolidColorBrush x:Key="Brush.ToastBg" Color="#241216" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Canvas" Color="#E9E2E4" />
    <SolidColorBrush x:Key="Brush.PageShadow" Color="#40000000" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#FBE3E6" />
    <SolidColorBrush x:Key="Brush.GridLine" Color="#F1E8EA" />
    <SolidColorBrush x:Key="Brush.Sticky" Color="#FFD966" />
    <SolidColorBrush x:Key="Brush.Link" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.BarMuted" Color="#D3C5C9" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />
</ResourceDictionary>
