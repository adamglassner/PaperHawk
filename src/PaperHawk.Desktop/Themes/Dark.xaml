<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (Hawkline, PaperHawk crimson). Every key here must also exist in Light.xaml.
         PDF pages themselves are always drawn white, like paper; Brush.Canvas is the area around them. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#140C0E" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1E1316" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#28191D" />
    <SolidColorBrush x:Key="Brush.Border" Color="#3A262B" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#332327" />
    <SolidColorBrush x:Key="Brush.Track" Color="#33232A" />
    <SolidColorBrush x:Key="Brush.Text" Color="#F1E6E8" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#B19CA1" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0C0607" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#BFA3AA" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#1E1013" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#36181F" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#1E1013" />
    <SolidColorBrush x:Key="Brush.Hero" Color="#6E1824" />
    <SolidColorBrush x:Key="Brush.HeroText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.HeroMuted" Color="#F2C9CF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF6F7D" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#2A060B" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#42191F" />
    <SolidColorBrush x:Key="Brush.Highlight" Color="#FF9EA8" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#F5B95A" />
    <SolidColorBrush x:Key="Brush.Marker" Color="#6B5A1C" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#E9A24A" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F07A4E" />
    <SolidColorBrush x:Key="Brush.Positive" Color="#6FD3A0" />
    <SolidColorBrush x:Key="Brush.ToastBg" Color="#F1E6E8" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#140C0E" />
    <SolidColorBrush x:Key="Brush.Canvas" Color="#0E0809" />
    <SolidColorBrush x:Key="Brush.PageShadow" Color="#90000000" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#42191F" />
    <SolidColorBrush x:Key="Brush.GridLine" Color="#2A1B1F" />
    <SolidColorBrush x:Key="Brush.Sticky" Color="#E7C24E" />
    <SolidColorBrush x:Key="Brush.Link" Color="#7AA7FF" />
    <SolidColorBrush x:Key="Brush.BarMuted" Color="#4A363B" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />
</ResourceDictionary>
